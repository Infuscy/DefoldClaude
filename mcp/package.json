{
  "name": "defold-mcp-server",
  "version": "0.2.7",
  "private": true,
  "license": "MIT",
  "description": "MCP server and hooks for the Defold game engine (bundled into plugins/defold/dist)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --dir test/unit",
    "test:corpus": "vitest run --dir test/corpus-tests",
    "test:integration": "vitest run --dir test/integration",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "fetch:corpus": "tsx scripts/fetch-corpus.ts",
    "check:skills": "tsx scripts/check-skills.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "luaparse": "^0.3.1",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/luaparse": "^0.2.13",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.28.2",
    "protobufjs": "^7.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
