local PAUSE = hash("pause")
local TOUCH = hash("touch")

local function show(self, visible)
	self.visible = visible
	gui.set_enabled(gui.get_node("panel"), visible)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	show(self, false)
end

function on_input(self, action_id, action)
	if action_id == PAUSE and action.pressed then
		show(self, not self.visible)
		return true
	end
	if not self.visible then
		return false
	end
	if action_id == TOUCH and action.pressed then
		if gui.pick_node(gui.get_node("resume"), action.x, action.y) then
			show(self, false)
		elseif gui.pick_node(gui.get_node("quit"), action.x, action.y) then
			msg.post("@system:", "exit", { code = 0 })
		end
	end
	-- While the menu is open it consumes all input, so the player does not react.
	return true
end
